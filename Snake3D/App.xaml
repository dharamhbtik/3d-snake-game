<Application x:Class="Snake3D.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters -->
      <converters:BoolToVisibilityConverter x:Key="BoolToVis" xmlns:converters="using:Snake3D.Converters" />
      <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" xmlns:converters="using:Snake3D.Converters" />

    </ResourceDictionary>
  </Application.Resources>

</Application>
