<Page x:Class="Snake3D.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:skia="using:SkiaSharp.Views.Windows"
      xmlns:vm="using:Snake3D.ViewModels"
      Background="#07090E"
      RequestedTheme="Dark">

  <Grid FocusVisualPrimaryThickness="0" IsTabStop="True" KeyDown="OnPageKeyDown">
    <!-- 3D Skia Rendering Canvas -->
    <skia:SKXamlCanvas x:Name="GameCanvas"
                       PaintSurface="OnPaintSurface"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />

    <!-- TOP HUD (Shown during Playing, Paused, GameOver) -->
    <Grid VerticalAlignment="Top"
          Margin="24,20,24,0"
          Visibility="{Binding ShowHud, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: Score and High Score Badges -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <!-- Current Score Pill -->
        <Border Background="#D00F172A"
                BorderBrush="#3338BDF8"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="SCORE"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Score}"
                       FontSize="20"
                       FontWeight="ExtraBold"
                       Foreground="#38BDF8"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- High Score Pill -->
        <Border Background="#D00F172A"
                BorderBrush="#33FBBF24"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="BEST"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding HighScore}"
                       FontSize="20"
                       FontWeight="ExtraBold"
                       Foreground="#FBBF24"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- Level Indicator -->
        <Border Background="#D00F172A"
                BorderBrush="#3334D399"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="LVL"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#94A3B8"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Level}"
                       FontSize="18"
                       FontWeight="ExtraBold"
                       Foreground="#34D399"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Right: Action Controls -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <!-- Speed Toggle in HUD -->
        <Button Command="{Binding CycleSpeedCommand}"
                Background="#D00F172A"
                BorderBrush="#3338BDF8"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,8"
                ToolTipService.ToolTip="Change Speed Mode">
          <TextBlock Text="{Binding SpeedLabel}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#38BDF8" />
        </Button>

        <!-- Sound Toggle -->
        <Button Command="{Binding ToggleSoundCommand}"
                Background="#D00F172A"
                BorderBrush="#33475569"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,8"
                ToolTipService.ToolTip="Toggle Sound">
          <TextBlock Text="🔊 SOUND"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#CBD5E1" />
        </Button>

        <!-- Pause Button (Playing state) -->
        <Button Command="{Binding PauseCommand}"
                Background="#D00F172A"
                BorderBrush="#33475569"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14,8"
                Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="⏸ PAUSE"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#F8FAFC" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- MAIN MENU OVERLAY -->
    <Grid Background="#70030712"
          Visibility="{Binding IsMenu, Converter={StaticResource BoolToVis}}">
      <Border Background="#EE0F172A"
              BorderBrush="#3338BDF8"
              BorderThickness="1"
              CornerRadius="24"
              Width="440"
              Padding="36,36"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
          <!-- Game Logo / Header -->
          <StackPanel Spacing="6" HorizontalAlignment="Center">
            <TextBlock Text="SNAKE 3D"
                       FontSize="42"
                       FontWeight="Black"
                       Foreground="#10B981"
                       HorizontalAlignment="Center" />
            <TextBlock Text="CLASSIC SNAKE IN 3D SPACE"
                       FontSize="11"
                       FontWeight="Bold"
                       CharacterSpacing="150"
                       Foreground="#64748B"
                       HorizontalAlignment="Center" />
          </StackPanel>

          <!-- High Score Banner -->
          <Border Background="#1E293B"
                  BorderBrush="#33FBBF24"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16,8"
                  HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="HIGH SCORE:"
                         FontSize="12"
                         FontWeight="Bold"
                         Foreground="#94A3B8"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding HighScore}"
                         FontSize="18"
                         FontWeight="ExtraBold"
                         Foreground="#FBBF24"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Speed Selection Panel -->
          <StackPanel Spacing="8">
            <TextBlock Text="GAME SPEED"
                       FontSize="11"
                       FontWeight="Bold"
                       CharacterSpacing="100"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Button Grid.Column="0"
                      Command="{Binding SetSpeedCommand}"
                      CommandParameter="Relaxed"
                      Background="#1E293B"
                      Foreground="#F8FAFC"
                      Margin="0,0,4,0"
                      Height="38"
                      HorizontalAlignment="Stretch"
                      CornerRadius="10">
                <TextBlock Text="🐢 Relaxed" FontSize="12" FontWeight="SemiBold" />
              </Button>

              <Button Grid.Column="1"
                      Command="{Binding SetSpeedCommand}"
                      CommandParameter="Normal"
                      Background="#1E293B"
                      Foreground="#F8FAFC"
                      Margin="2,0,2,0"
                      Height="38"
                      HorizontalAlignment="Stretch"
                      CornerRadius="10">
                <TextBlock Text="🎯 Normal" FontSize="12" FontWeight="SemiBold" />
              </Button>

              <Button Grid.Column="2"
                      Command="{Binding SetSpeedCommand}"
                      CommandParameter="Fast"
                      Background="#1E293B"
                      Foreground="#F8FAFC"
                      Margin="4,0,0,0"
                      Height="38"
                      HorizontalAlignment="Stretch"
                      CornerRadius="10">
                <TextBlock Text="⚡ Fast" FontSize="12" FontWeight="SemiBold" />
              </Button>
            </Grid>
          </StackPanel>

          <!-- Play Button -->
          <Button Command="{Binding StartGameCommand}"
                  Background="#10B981"
                  Foreground="#022C22"
                  FontSize="16"
                  FontWeight="ExtraBold"
                  Height="52"
                  HorizontalAlignment="Stretch"
                  CornerRadius="14">
            <TextBlock Text="PLAY GAME" FontWeight="ExtraBold" />
          </Button>

          <!-- Controls Guide Card -->
          <Border Background="#0B1120"
                  BorderBrush="#1E293B"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="18,16">
            <StackPanel Spacing="10">
              <TextBlock Text="CONTROLS"
                         FontSize="11"
                         FontWeight="Bold"
                         CharacterSpacing="100"
                         Foreground="#475569" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                  <TextBlock Text="W A S D / Arrows" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                  <TextBlock Text="Steer Snake" FontSize="11" Foreground="#64748B" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="SPACE / ESC" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" />
                  <TextBlock Text="Pause / Resume" FontSize="11" Foreground="#64748B" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- PAUSE MODAL OVERLAY -->
    <Grid Background="#99030712"
          Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
      <Border Background="#F20F172A"
              BorderBrush="#3364748B"
              BorderThickness="1"
              CornerRadius="24"
              Width="360"
              Padding="32,36"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
          <TextBlock Text="GAME PAUSED"
                     FontSize="26"
                     FontWeight="Bold"
                     Foreground="#F8FAFC"
                     HorizontalAlignment="Center" />

          <!-- Current Score Display -->
          <Border Background="#1E293B"
                  CornerRadius="12"
                  Padding="16,10"
                  HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="CURRENT SCORE:"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="#94A3B8"
                         VerticalAlignment="Center" />
              <TextBlock Text="{Binding Score}"
                         FontSize="18"
                         FontWeight="Bold"
                         Foreground="#38BDF8"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <!-- Buttons -->
          <Button Command="{Binding ResumeCommand}"
                  Background="#10B981"
                  Foreground="#022C22"
                  FontSize="15"
                  FontWeight="Bold"
                  Height="46"
                  HorizontalAlignment="Stretch"
                  CornerRadius="12">
            <TextBlock Text="RESUME" FontWeight="Bold" />
          </Button>

          <Button Command="{Binding RestartCommand}"
                  Background="#1E293B"
                  Foreground="#F8FAFC"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Height="44"
                  HorizontalAlignment="Stretch"
                  CornerRadius="12">
            <TextBlock Text="RESTART" />
          </Button>

          <Button Command="{Binding GoToMenuCommand}"
                  Background="Transparent"
                  BorderBrush="#33475569"
                  BorderThickness="1"
                  Foreground="#94A3B8"
                  FontSize="14"
                  Height="42"
                  HorizontalAlignment="Stretch"
                  CornerRadius="12">
            <TextBlock Text="MAIN MENU" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>

    <!-- GAME OVER MODAL OVERLAY -->
    <Grid Background="#B0030712"
          Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVis}}">
      <Border Background="#F40F172A"
              BorderBrush="#33EF4444"
              BorderThickness="1"
              CornerRadius="24"
              Width="380"
              Padding="32,36"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="20" HorizontalAlignment="Stretch">
          <!-- Game Over Title -->
          <TextBlock Text="GAME OVER"
                     FontSize="32"
                     FontWeight="Black"
                     Foreground="#EF4444"
                     HorizontalAlignment="Center" />

          <!-- New Record Badge -->
          <Border Background="#2010B981"
                  BorderBrush="#10B981"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12,6"
                  HorizontalAlignment="Center"
                  Visibility="{Binding IsNewHighScore, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="★ NEW HIGH SCORE! ★"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#34D399" />
          </Border>

          <!-- Stats Grid -->
          <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Final Score -->
            <Border Grid.Column="0"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="12,12"
                    Margin="0,0,6,0">
              <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="FINAL SCORE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Score}"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="#F8FAFC"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- Best Score -->
            <Border Grid.Column="1"
                    Background="#1E293B"
                    CornerRadius="12"
                    Padding="12,12"
                    Margin="6,0,0,0">
              <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="BEST SCORE"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding HighScore}"
                           FontSize="24"
                           FontWeight="Black"
                           Foreground="#FBBF24"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Buttons -->
          <Button Command="{Binding RestartCommand}"
                  Background="#10B981"
                  Foreground="#022C22"
                  FontSize="15"
                  FontWeight="ExtraBold"
                  Height="48"
                  HorizontalAlignment="Stretch"
                  CornerRadius="12">
            <TextBlock Text="PLAY AGAIN" FontWeight="Bold" />
          </Button>

          <Button Command="{Binding GoToMenuCommand}"
                  Background="Transparent"
                  BorderBrush="#33475569"
                  BorderThickness="1"
                  Foreground="#94A3B8"
                  FontSize="14"
                  Height="42"
                  HorizontalAlignment="Stretch"
                  CornerRadius="12">
            <TextBlock Text="MAIN MENU" />
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
